// V1 shape. OpenCode V2 still loads this, but timeout is one number for
// startup, catalog, and tool calls. 30000 covers tools/list and cuts
// project_replace and large searches. For V2 use opencode.v2.jsonc.example
// and do not copy 30000 into timeout.execution.
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem-ultra": {
      "type": "local",
      "command": [
        "C:\\path\\to\\filesystem-ultra-v4.exe",
        "--profile", "strict",
        "--compact-mode",
        "--roots-mode", "union",
        "C:\\path\\to\\workspace"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
